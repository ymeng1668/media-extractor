set(_platform "x86_64_gcc_13_3_0")
if(WIN32)
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_platform "x64_msvc_2026")
    else()
        set(_platform "x86_msvc_2026")
    endif()
endif()
set(_root "${CMAKE_CURRENT_BINARY_DIR}/_deps/streamax_ai_sdk")
set(MEDIA_AI_SDK_DIR "${_root}/${_platform}" CACHE PATH "Optional Streamax AI SDK platform directory")
set(_archive "${CMAKE_CURRENT_LIST_DIR}/../doc/streamax_ainfo_parse_api/2026-09-22/streamax_ai_sdk.zip")
if(MEDIA_AI_SDK_DIR STREQUAL "${_root}/${_platform}" AND EXISTS "${_archive}")
    file(SHA256 "${_archive}" _hash)
    set(_old "")
    if(EXISTS "${_root}/archive.sha256")
        file(READ "${_root}/archive.sha256" _old)
    endif()
    if(NOT _old STREQUAL _hash OR NOT EXISTS "${MEDIA_AI_SDK_DIR}")
        file(MAKE_DIRECTORY "${_root}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${_archive}"
            WORKING_DIRECTORY "${_root}" RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Cannot extract Streamax AI SDK")
        endif()
        file(WRITE "${_root}/archive.sha256" "${_hash}")
    endif()
endif()
target_compile_definitions(media_extractor_core PRIVATE MEDIA_AI_SDK_DEFAULT_DIR="${MEDIA_AI_SDK_DIR}")
if(UNIX AND NOT APPLE)
    # The vendor dependency has no SONAME; the SDK loads it by basename.
    set(CMAKE_BUILD_RPATH "${MEDIA_AI_SDK_DIR}/lib;${MEDIA_AI_SDK_DIR}/opencv453/lib")
endif()
